generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  SOCIO
  ADMIN
}

enum EstadoPago {
  AL_DIA
  VENCIDO
}

enum MetodoPago {
  MERCADO_PAGO
  EFECTIVO
}

enum GrupoMuscular {
  PECHO
  ESPALDA
  PIERNAS
  HOMBRO
  BICEPS
  TRICEPS
  ABDOMINALES
}

model Usuario {
  id           String     @id @default(uuid())
  dni          String     @unique
  nombre       String
  email        String?
  passwordHash String
  rol          Rol        @default(SOCIO)
  creadoEn     DateTime   @default(now())
  estadoPago   EstadoPago @default(AL_DIA)
  vencimiento  DateTime?
  rutina       Rutina?
  asistencias   Asistencia[]
  registros      Registro[]
  pushTokens     PushToken[]
  pagos          Pago[]
}

model Ejercicio {
  id            String            @id @default(uuid())
  nombre        String
  grupoMuscular GrupoMuscular
  descripcion   String?
  imagenUrl     String?
  rutinas       RutinaEjercicio[]
}

model Rutina {
  id         String            @id @default(uuid())
  nombre     String            @default("Mi Rutina")
  usuarioId  String            @unique
  usuario    Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  ejercicios RutinaEjercicio[]
  creadoEn   DateTime          @default(now())
}

model RutinaEjercicio {
  id           String    @id @default(uuid())
  rutinaId     String
  rutina       Rutina    @relation(fields: [rutinaId], references: [id], onDelete: Cascade)
  ejercicioId  String
  ejercicio    Ejercicio @relation(fields: [ejercicioId], references: [id], onDelete: Cascade)
  series       Int       @default(4)
  repeticiones String    @default("10-12")
  orden        Int       @default(0)
  dia          String?
}

model Asistencia {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  dia       String
  creadoEn  DateTime @default(now())

  @@unique([usuarioId, dia])
}

model Registro {
  id           String   @id @default(uuid())
  usuarioId    String
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  ejercicioId  String
  dia          String
  peso         Float
  series       Int      @default(0)
  repeticiones Int      @default(0)
  creadoEn     DateTime @default(now())

  @@unique([usuarioId, ejercicioId, dia])
}

model PushToken {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  token     String   @unique
  creadoEn  DateTime @default(now())
}

model Pago {
  id            String      @id @default(uuid())
  usuarioId     String
  usuario       Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  monto         Float
  periodo       String
  metodo        MetodoPago
  registradoPor String?
  pagadoEn      DateTime    @default(now())
}
