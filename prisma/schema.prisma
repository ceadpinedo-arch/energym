generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  SOCIO
  ADMIN
}

enum EstadoPago {
  AL_DIA
  VENCIDO
}

enum MetodoPago {
  MERCADO_PAGO
  EFECTIVO
}

enum GrupoMuscular {
  PECHO
  ESPALDA
  PIERNAS
  HOMBRO
  BICEPS
  TRICEPS
  ABDOMINALES
}

model Usuario {
  id           String     @id @default(uuid())
  dni          String     @unique
  nombre       String
  email        String?
  passwordHash String
  rol          Rol        @default(SOCIO)
  creadoEn     DateTime   @default(now())
  estadoPago   EstadoPago @default(AL_DIA)
  vencimiento  DateTime?
  rutina       Rutina?
}

model Ejercicio {
  id            String            @id @default(uuid())
  nombre        String
  grupoMuscular GrupoMuscular
  descripcion   String?
  imagenUrl     String?
  rutinas       RutinaEjercicio[]
}

model Rutina {
  id         String            @id @default(uuid())
  nombre     String            @default("Mi Rutina")
  usuarioId  String            @unique
  usuario    Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  ejercicios RutinaEjercicio[]
  creadoEn   DateTime          @default(now())
}

model RutinaEjercicio {
  id           String    @id @default(uuid())
  rutinaId     String
  rutina       Rutina    @relation(fields: [rutinaId], references: [id], onDelete: Cascade)
  ejercicioId  String
  ejercicio    Ejercicio @relation(fields: [ejercicioId], references: [id], onDelete: Cascade)
  series       Int       @default(4)
  repeticiones String    @default("10-12")
  orden        Int       @default(0)
  dia          String?
}
